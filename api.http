### Variables
@baseUrl = http://localhost:3000

### 1. Shorten a URL (Create Short URL)
# @name createShortUrl
POST {{baseUrl}}/shorten
Content-Type: application/json

{
  "originalUrl": "https://google.com"
}

### 2. List All Shortened URLs
GET {{baseUrl}}/urls
Accept: application/json

### 3. Redirect to Original URL
# Replace 'LtPKftW7' with any generated shortCode
GET {{baseUrl}}/LtPKftW7
